# Copy to config.env (git-ignored) and fill in the blanks.
#   cp config.example.env config.env

# --- Azure ---
LOCATION=westeurope
RG=rg-hybrid-lab

HUB_VNET=vnet-hub
HUB_PREFIX=10.0.0.0/16
GATEWAY_SUBNET_PREFIX=10.0.0.0/27

SPOKE_VNET=vnet-spoke
SPOKE_PREFIX=10.1.0.0/16
WORKLOAD_SUBNET=snet-workload
WORKLOAD_SUBNET_PREFIX=10.1.1.0/24

VPN_GW=vgw-hub
VPN_GW_PIP=pip-vpngw
VPN_GW_SKU=VpnGw1          # use VpnGw1AZ if your region requires zone-redundant SKUs
LOCAL_GW=lgw-onprem
CONNECTION=cn-azure-to-onprem

NSG=nsg-workload
VM_NAME=AZ-VM01
VM_SIZE=Standard_B2s
VM_ADMIN_USER=azadmin
VM_ADMIN_PASSWORD=          # 12+ chars, upper/lower/digit/symbol

# --- On-prem ---
ONPREM_CIDR=192.168.10.0/24
ONPREM_PUBLIC_IP=           # your home router's public IP (or a DDNS name)
DC_IP=192.168.10.10

# Long random string, used on both sides of the tunnel
SHARED_KEY=
